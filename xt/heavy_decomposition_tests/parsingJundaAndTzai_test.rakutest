use Test;
use parseJundaAndTzaiToDatabase;


my $junda-path = 'resources/official-cjk-files/Junda2005.txt'.IO;
my $tzai-path = 'resources/official-cjk-files/Tzai2006.txt'.IO;
my $junda-file  = $*PROGRAM.parent.parent.parent.add('resources/official-cjk-files/Junda2005.txt');
my $tzai-file   = $*PROGRAM.parent.parent.parent.add('resources/official-cjk-files/Tzai2006.txt');

plan 2;


subtest 'parse-cjk-character-frequency - count all frequency characters' => {

    my %frequencies = parse-junda-and-tzai($junda-file.IO, $tzai-file.IO);
    say "Parsing character frequencies...";
    is %frequencies.elems, 16373, 'exactly 16373 character parsed';
}

subtest 'parse-cjk-character-frequency - find specific frequency characters' => {

    my %result = parse-junda-and-tzai($junda-path, $tzai-path);

    ok %result<知>:exists, "'知' exists in the result";

    # Verify '知' values
    # Junda: 123	知	306384	...
    is %result<知><junda-ord>, 123, "Junda rank for '知' is 123";

    # Tzai: 知      434311   8 (rank 71)
    is %result<知><tzai-ord>, 71, "Tzai rank for '知' is 71";

    # Verify Rat type
    isa-ok %result<知><junda-freq>, Rat, "Junda frequency is a Rat";
    isa-ok %result<知><tzai-freq>, Rat, "Tzai frequency is a Rat";

    # Check one more: '的' should be rank 1 in both
    is %result<的><junda-ord>, 1, "'的' Junda rank is 1";
    is %result<的><tzai-ord>, 1, "'的' Tzai rank is 1";
}